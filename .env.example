# 複製成 .env 後修改(docker compose 會自動讀取專案根目錄的 .env)。
# 不設定任何東西也能跑:預設使用內建的 mock 模型,不需要任何金鑰。

# ---------------------------------------------------------------------------
# 模型供應商(工廠):有序清單,第一個是「主要」,其餘依序「備援」
#   LLM_PROVIDERS=gemini,groq                     主要 Gemini,Gemini 壞掉時換 Groq
#   LLM_PROVIDERS=gemini:gemini-2.5-flash,gemini  同一家的兩個模型(防模型層級的故障/配額,防不了整家掛掉)
#   LLM_PROVIDERS=mock                            預設
# 可用名稱:mock / gemini / groq / openai / ollama。切換 = 改這一行再 `docker compose up -d chat`
# ---------------------------------------------------------------------------
LLM_PROVIDERS=mock

# --- Gemini(主要)---------------------------------------------------------
# 金鑰:https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 模型更新很快,舊版會被下架或導向新版,所以放在這裡而不是寫死。選 Flash-Lite 這一級最省:
# 聊天回覆短,不需要深度推理。
# GEMINI_MODEL=gemini-2.5-flash-lite

# 思考(thinking)token 以「輸出價」計費,對簡短聊天是純成本,所以預設關閉。
# 不同世代的參數不同,送錯會被忽略(照樣收費)或被拒絕(400,此時會自動換備援並記錄 error):
#   budget:0        Gemini 2.5 系列(預設)
#   level:minimal   Gemini 3 系列(minimal / low / medium / high,實際可用值依模型而定)
#   omit            不送思考設定,用模型預設
# GEMINI_THINKING=budget:0

# --- 備援供應商(擇一或不設)------------------------------------------------
# Groq(OpenAI 相容,有免費額度):金鑰 https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Ollama(本機模型,免金鑰;容器內連主機用 host.docker.internal)
# OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# 成本控制:輸入(每次請求都要重送並計費)與輸出都要設上限。空白 = 用括號內的預設值
# ---------------------------------------------------------------------------
# LLM_MAX_OUTPUT_TOKENS=300      單次回覆輸出 token 上限
# CONTEXT_MESSAGES=12            最多帶幾則歷史訊息
# CONTEXT_CHARS=2500             歷史總字元上限
# CONTEXT_MSG_MAX_CHARS=400      單則歷史訊息超過就截斷
# USER_MESSAGE_MAX_CHARS=500     使用者單則訊息上限

# ---------------------------------------------------------------------------
# 備援行為
# ---------------------------------------------------------------------------
# LLM_ATTEMPT_FIRST_TOKEN_MS=8000     每個供應商等第一個字的上限,逾時就換下一個
# LLM_STALL_MS=15000                  串流中途卡住超過這麼久視為失敗
# LLM_BREAKER_FAILURES=3              連續失敗幾次後暫停這個供應商
# LLM_BREAKER_COOLDOWN_MS=20000       暫停多久後放一個探測請求進去
