{
  "name": "chat-app-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Chat APP AI 陪伴 App 後端:Bun + TypeScript 微服務(Bun workspaces monorepo,每個服務各自一個 Docker container)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "booking/services/booking"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:gateway": "bun --filter @chat-app/gateway dev",
    "dev:auth": "bun --filter @chat-app/auth dev",
    "dev:character": "bun --filter @chat-app/character dev",
    "dev:chat": "bun --filter @chat-app/chat dev",
    "dev:billing": "bun --filter @chat-app/billing dev",
    "dev:admin": "bun --filter @chat-app/admin dev",
    "dev:booking": "bun --filter @chat-app/booking dev",
    "migrate": "bun scripts/migrate.ts",
    "smoke": "bun scripts/smoke.ts",
    "loadtest": "bun scripts/loadtest.ts"
  },
  "dependencies": {
    "@chat-app/shared": "workspace:*",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
