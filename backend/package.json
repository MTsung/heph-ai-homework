{
  "name": "chat-app-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Chat APP AI 陪伴 App 後端:Bun + TypeScript 微服務(單一 monorepo,每個服務各自一個 Docker container)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:gateway": "bun --watch services/gateway/src/main.ts",
    "dev:auth": "bun --watch services/auth/src/main.ts",
    "dev:character": "bun --watch services/character/src/main.ts",
    "dev:chat": "bun --watch services/chat/src/main.ts",
    "dev:billing": "bun --watch services/billing/src/main.ts",
    "dev:admin": "bun --watch services/admin/src/main.ts",
    "dev:booking": "bun --watch booking/services/booking/src/main.ts",
    "smoke": "bun scripts/smoke.ts",
    "loadtest": "bun scripts/loadtest.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "playwright": "1.65.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
