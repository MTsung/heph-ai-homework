# llm-check.ts 用的測試環境:chat 走 gemini → groq 備援鏈,但兩者都指向 fake-llm(不需要真實金鑰)。
# 逾時/冷卻都縮短,測試才不用等很久。⚠ 金鑰是假的,限流被放寬 —— 只用於本機驗證,不要用在別處。
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=fake-gemini-key
GEMINI_BASE_URL=http://fake-llm:9000/gemini
GROQ_API_KEY=fake-groq-key
GROQ_BASE_URL=http://fake-llm:9000/openai
LLM_ATTEMPT_FIRST_TOKEN_MS=1500
LLM_STALL_MS=1500
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_MS=6000
# 驗證腳本會註冊很多使用者、送很多訊息,放寬 gateway 限流
RL_AUTH_PER_IP_PER_MIN=100000
RL_SEND_PER_USER_PER_MIN=100000
RL_USER_PER_MIN=1000000
